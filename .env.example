# Copy to .env and fill in. Never commit .env.

# Host folder that contains Playnite's games.db (mounted read-only).
PLAYNITE_LIBRARY_DIR=/path/to/Playnite/library

# Which interface to publish on. Keep 127.0.0.1 unless you put a VPN /
# reverse proxy in front. Do not put real addresses in this file in git.
GAME_REMOTE_BIND=127.0.0.1
GAME_REMOTE_PORT=8765

# Optional shared secret required by the API (leave empty to disable).
GAME_REMOTE_TOKEN=

# Optional: full base URL of moonlight-web if it is not on the same host:8080.
MOONLIGHT_WEB_URL=
MOONLIGHT_WEB_PORT=8080

# Optional: JSON list of [old_prefix, new_prefix] install-path remaps.
GAME_REMOTE_PATH_REMAPS=[]

# Optional extensions (comma-separated module names) and where they live.
GAME_REMOTE_EXTENSIONS=
GAME_REMOTE_EXTENSIONS_DIR=./extensions_dir
